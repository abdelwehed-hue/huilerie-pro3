# Copy to backend/.env on the Windows mill PC and replace every placeholder.
# This sample intentionally contains no production credentials or Atlas connection.
APP_ENV=local
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
DB_NAME=oroverde_local
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_DISABLED=false
# Replace with the exact browser origin used on the mill LAN, e.g. http://192.168.1.20:3000
CORS_ORIGINS=http://127.0.0.1:3000
