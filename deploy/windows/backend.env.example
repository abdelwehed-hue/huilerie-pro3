# Copy to backend/.env on the Windows mill PC and replace every placeholder.
# This profile is isolated from Render/Atlas.
APP_ENV=production
SERVE_FRONTEND=true
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
DB_NAME=oroverde_local
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_DISABLED=false
# First boot on an empty DB only; choose a unique username and password (16+ chars).
INITIAL_ADMIN_USERNAME=REPLACE_WITH_UNIQUE_ADMIN_USERNAME
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_16_CHARS
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
